<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stands in for adb, java and the JADX server in tests, so the external-tool paths run on every host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Corvus.Tests publishes it as a native program for this host, which starts in about a quarter of the time. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
