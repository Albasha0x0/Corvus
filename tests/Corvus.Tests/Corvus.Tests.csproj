<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- ChildTest.Main runs a test's body in a process of its own. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>Corvus.Tests.ChildTest</StartupObject>
  </PropertyGroup>

  <!-- Quick-set time on 20 threads: one workstation GC heap made it 43 s instead of 33 s; tiered PGO's instrumented code
       costs about 2 s more in a run this short. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Server" Value="true" />
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredPGO" Value="false" />
  </ItemGroup>

  <!-- dotnet test runs the quick set; CORVUS_ALL_TESTS=1 (environment or -p:) also runs the tests marked Speed=Slow. -->
  <PropertyGroup Condition="'$(CORVUS_ALL_TESTS)' != '1'">
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)quick.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CORVUS_ALL_TESTS)' == '1'">
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)full.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also a real library the tests export (restores AsmResolver and AsmResolver.PE.File with it); the native PE sweep uses it as an oracle. -->
    <PackageReference Include="AsmResolver.PE" Version="6.0.0-beta.5" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <!-- Validates the SBOMs summarize_file writes against the CycloneDX schemas. -->
    <PackageReference Include="CycloneDX.Core" Version="12.1.2" />
    <!-- Generates the inputs of the reader round-trip properties. -->
    <PackageReference Include="FsCheck" Version="3.4.0" />
    <!-- ELF / Mach-O oracle for the native format readers. -->
    <PackageReference Include="LibObjectFile" Version="2.3.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- as the server references it: aliased, so its global PEFile namespace stays out of these sources -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" ExcludeAssets="build;buildTransitive" Aliases="TraceEventPackage" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="NativeFormats\ItaniumCorpus.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="NativeFormats\SwiftManglings.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\QuicInitials.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\Http3Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\TlsSessions.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TokenCorpus\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Engines\IsaFixtures\*.elf;Engines\IsaFixtures\*.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="NativeAnalysis\StringFormFixtures\*.elf;NativeAnalysis\StringFormFixtures\*.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Dumps\CfiFixtures\*.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Web\HermesFixtures\*.hbc" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\PythonFixtures\*.pyc;Containers\PythonFixtures\*.dis" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Web\ScriptFixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Web\BeautifyFixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\FirmwareFixtures\*.gz;Containers\FirmwareFixtures\*.list;Containers\FirmwareFixtures\reference.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\DiskFixtures\*.gz;Containers\InstallerFixtures\*.gz" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\LzfseFixtures\*.lzfse" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Mobile\ArkFixtures\*.abc;Mobile\ArkFixtures\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\GameMakerFixtures\*.win" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\LuaFixtures\*.luac;Containers\LuaFixtures\*.ljbc" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\AutoItFixtures\*.a3x;Containers\AutoItFixtures\*.au3;Containers\AutoItFixtures\notes.txt;Containers\AutoItFixtures\build.ps1;Containers\AutoItFixtures\reference.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Databases\LevelDbFixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Databases\LmdbFixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Databases\EseFixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Databases\BerkeleyDbFixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Databases\RealmFixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\LinuxAppFixtures\*.AppImage;Containers\LinuxAppFixtures\*.snap;Containers\LinuxAppFixtures\*.sh;Containers\LinuxAppFixtures\*.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\RpmFixtures\*.rpm;Containers\RpmFixtures\*.sh;Containers\RpmFixtures\*.spec" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\GodotFixtures\*.pck;Containers\GodotFixtures\*.gd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\UnrealFixtures\*.pak;Containers\UnrealFixtures\*.utoc;Containers\UnrealFixtures\*.ucas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Containers\StixSchemas\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Real libraries the tests decompile, compare and export (downloaded on restore, not referenced). -->
  <ItemGroup>
    <PackageDownload Include="BouncyCastle.Cryptography" Version="[2.6.2]" />
    <PackageDownload Include="Newtonsoft.Json" Version="[12.0.2];[13.0.1];[13.0.4]" />
    <PackageDownload Include="NLog" Version="[6.1.4]" />
    <PackageDownload Include="NUnit" Version="[3.14.0]" />
    <PackageDownload Include="System.Text.Json" Version="[10.0.1]" />
    <PackageDownload Include="System.IO.Pipelines" Version="[10.0.1]" />
    <PackageDownload Include="System.Collections.Immutable" Version="[1.3.1]" />
    <PackageDownload Include="System.Numerics.Vectors" Version="[4.5.0]" />
    <!-- an exported net462 project: the reference assemblies it is classified against, and the package its ValueTuple facade becomes -->
    <PackageDownload Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="[1.0.3]" />
    <PackageDownload Include="System.ValueTuple" Version="[4.5.0]" />
    <PackageDownload Include="System.Runtime.CompilerServices.Unsafe" Version="[6.0.0]" />
    <PackageDownload Include="SharpCompress" Version="[0.48.1]" />
    <PackageDownload Include="ZstdSharp.Port" Version="[0.8.8]" />
    <PackageDownload Include="Iced" Version="[1.21.0]" />
    <PackageDownload Include="OggVorbisEncoder" Version="[1.2.2]" />
    <!-- A library with its Portable PDB beside it and SourceLink (get_il source=true). -->
    <PackageDownload Include="Mono.Cecil" Version="[0.11.3]" />
  </ItemGroup>

  <!-- NativeAOT-compiled production binaries (tools/ilc of the ILCompiler runtime packs: PE, ELF, Mach-O) for the slow NativeAOT tests. -->
  <ItemGroup Condition="'$(CORVUS_ALL_TESTS)' == '1'">
    <PackageDownload Include="runtime.win-x64.Microsoft.DotNet.ILCompiler" Version="[8.0.30];[9.0.19];[10.0.11]" />
    <PackageDownload Include="runtime.win-arm64.Microsoft.DotNet.ILCompiler" Version="[10.0.11]" />
    <PackageDownload Include="runtime.win-x86.Microsoft.DotNet.ILCompiler" Version="[10.0.11]" />
    <PackageDownload Include="runtime.linux-arm.Microsoft.DotNet.ILCompiler" Version="[10.0.11]" />
    <PackageDownload Include="runtime.linux-x64.Microsoft.DotNet.ILCompiler" Version="[10.0.11]" />
    <PackageDownload Include="runtime.linux-arm64.Microsoft.DotNet.ILCompiler" Version="[10.0.11]" />
    <PackageDownload Include="runtime.osx-arm64.Microsoft.DotNet.ILCompiler" Version="[10.0.11]" />
    <PackageDownload Include="Gee.External.Capstone" Version="[2.3.0]" />
    <!-- A native DLL with its matching PDB (load_pdb, PDB symbols and types). -->
    <PackageDownload Include="HarfBuzzSharp.NativeAssets.Win32" Version="[14.2.0]" />
  </ItemGroup>

  <!-- Native images in ELF, Mach-O, ARM64 and ARM PE form for the native format readers and code analysis (runtimes/<rid>/native). -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.Diagnostics.DbgShim.linux-arm64" Version="[9.0.621003]" />
    <PackageDownload Include="Microsoft.Diagnostics.DbgShim.linux-musl-arm64" Version="[9.0.621003]" />
    <PackageDownload Include="Microsoft.Diagnostics.DbgShim.linux-arm" Version="[9.0.621003]" />
    <PackageDownload Include="Microsoft.Diagnostics.DbgShim.linux-x64" Version="[9.0.621003]" />
    <PackageDownload Include="Microsoft.Diagnostics.DbgShim.osx-x64" Version="[9.0.621003]" />
    <PackageDownload Include="Microsoft.Diagnostics.DbgShim.osx-arm64" Version="[9.0.621003]" />
    <PackageDownload Include="Microsoft.Diagnostics.DbgShim.win-arm64" Version="[9.0.621003]" />
    <PackageDownload Include="Microsoft.Diagnostics.DbgShim.win-arm" Version="[9.0.553101]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.osx-arm64" Version="[10.0.11]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.win-arm64" Version="[10.0.11]" />
    <PackageDownload Include="SkiaSharp.NativeAssets.macOS" Version="[2.88.9]" />
    <!-- Objective-C (classes, categories on Foundation classes, ivars) and Swift (types, fields, conformances) metadata. -->
    <PackageDownload Include="Microsoft.macOS.Runtime.osx-arm64" Version="[14.2.8078]" />
    <PackageDownload Include="SwiftBindings.Stripe.UICore" Version="[26.11.0]" />
    <!-- Quick-set tests read these too (Apple bundles, code signatures, rpath checks; SQLite oracle, crypto constants, showcases). -->
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.osx-arm64" Version="[10.0.11]" />
    <!-- Stripped ELF and Mach-O libraries with their separate DWARF (.so.dbg, .dylib.dwarf): load_pdb on ELF and Mach-O. -->
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.linux-x64" Version="[10.0.11]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.osx-arm64" Version="[10.0.11]" />
    <PackageDownload Include="SQLitePCLRaw.lib.e_sqlite3" Version="[2.1.2];[2.1.11]" />
    <PackageDownload Include="SkiaSharp.NativeAssets.Win32" Version="[2.88.9]" />
    <!-- Emscripten-built WebAssembly runtimes with their JS glue, three builds (WebAssembly code, validation, glue, interface compare). -->
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.Mono.browser-wasm" Version="[8.0.22];[9.0.11];[10.0.11]" />
  </ItemGroup>
  <!-- Large runtime packs for the slow native format tests only. -->
  <ItemGroup Condition="'$(CORVUS_ALL_TESTS)' == '1'">
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.linux-arm64" Version="[10.0.11]" />
    <PackageDownload Include="SkiaSharp.NativeAssets.Linux" Version="[3.119.4]" />
    <PackageDownload Include="Microsoft.Android.Runtime.35.android-arm64" Version="[35.0.105]" />
    <PackageDownload Include="Microsoft.Android.Ref.35" Version="[35.0.105]" />
    <PackageDownload Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="[1.0.3]" />
    <PackageDownload Include="Microsoft.Android.Runtime.35.android-arm" Version="[35.0.105]" />
    <!-- the DWARF corpus: the same libraries and debug files for four more Linux targets (load_pdb against llvm-dwarfdump) -->
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.linux-arm" Version="[10.0.11]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.linux-arm64" Version="[10.0.11]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.linux-musl-x64" Version="[10.0.11]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.linux-musl-arm64" Version="[10.0.11]" />
    <!-- a minified bundle with its source map (analyze_js) -->
    <PackageDownload Include="jQuery" Version="[3.7.1]" />
    <!-- embedded protobuf descriptors (.NET and native protoc) and the protoc oracle; generated gRPC and Refit clients -->
    <PackageDownload Include="Google.Protobuf" Version="[3.36.2]" />
    <PackageDownload Include="Grpc.Tools" Version="[2.84.0]" />
    <PackageDownload Include="Grpc.HealthCheck" Version="[2.84.0]" />
    <PackageDownload Include="Refit" Version="[10.0.1]" />
    <!-- jars for the class-file reader against javap: Guava for Android (Java 8) and the Kotlin standard library, in binding .aar files -->
    <PackageDownload Include="Xamarin.Google.Guava" Version="[33.6.0.1]" />
    <PackageDownload Include="Xamarin.Kotlin.StdLib" Version="[2.3.21]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Corvus\Corvus.csproj" />
    <ProjectReference Include="..\TestFixture\TestFixture.csproj" />
    <ProjectReference Include="..\TestFixture.Consumer\TestFixture.Consumer.csproj" />
    <ProjectReference Include="..\TestFixture.FakeTools\TestFixture.FakeTools.csproj" />
    <!-- The documentation site generator, whose output the link tests check. -->
    <ProjectReference Include="..\..\tools\DocsSite\DocsSite.csproj" />
  </ItemGroup>

  <!-- The fake tools also as a native program, which starts in about 20 ms instead of 70 ms. FakeTool.Executable takes it
       when it exists and the managed program otherwise, as on a host without the native toolchain;
       CorvusNativeFakeTools=false skips it. -->
  <ItemGroup>
    <FakeToolsSources Include="$(MSBuildThisFileDirectory)..\TestFixture.FakeTools\*.cs;$(MSBuildThisFileDirectory)..\TestFixture.FakeTools\*.csproj" />
  </ItemGroup>
  <Target Name="NativeFakeToolsPaths">
    <PropertyGroup>
      <NativeFakeToolsDir>$(OutDir)fake-tools-native</NativeFakeToolsDir>
      <NativeFakeTools>$(NativeFakeToolsDir)\TestFixture.FakeTools</NativeFakeTools>
      <NativeFakeTools Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(NativeFakeTools).exe</NativeFakeTools>
      <!-- Workaround: the Build Tools' vcvarsall.bat runs vswhere.exe from PATH, and the native link fails without it
           (VS 2022 Build Tools 17.14 with ILCompiler 10.0.13; upstream report pending). -->
      <VsInstallerOnPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">set &quot;PATH=$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer%3B%PATH%&quot; &amp;&amp; </VsInstallerOnPath>
    </PropertyGroup>
  </Target>
  <Target Name="PublishNativeFakeTools" AfterTargets="Build" DependsOnTargets="NativeFakeToolsPaths" Condition="'$(CorvusNativeFakeTools)' != 'false'"
          Inputs="@(FakeToolsSources)" Outputs="$(NativeFakeTools)">
    <Exec Command="$(VsInstallerOnPath)dotnet publish &quot;$(MSBuildThisFileDirectory)..\TestFixture.FakeTools\TestFixture.FakeTools.csproj&quot; --no-restore -c Release -r $(NETCoreSdkRuntimeIdentifier) -o &quot;$(NativeFakeToolsDir)&quot; --nologo -v q"
          ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true" />
    <Message Importance="high" Condition="!Exists('$(NativeFakeTools)')" Text="The native fake tools were not built: the tests start the managed program." />
  </Target>

  <!-- The guides' samples: built in their own bin/ folders, where the guide and showcase pages read them. -->
  <ItemGroup>
    <ProjectReference Include="..\..\samples\Notes\v1\Notes.csproj;..\..\samples\Notes\v2\Notes.csproj" ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;TargetFramework" />
  </ItemGroup>

  <!-- Programs the tests compile with external toolchains (pipeline round trip, NativeAOT samples): data, not part of this project. -->
  <ItemGroup>
    <Compile Remove="PipelineSamples\**" />
    <None Include="PipelineSamples\**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="NativeAotSample\**" />
    <Compile Remove="Databases\EseFixtures\build.cs" />
    <None Include="NativeAotSample\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>