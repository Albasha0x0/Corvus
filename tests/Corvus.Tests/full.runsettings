<?xml version="1.0" encoding="utf-8"?>
<!-- CORVUS_ALL_TESTS=1: the sweeps spread their own work over every processor and run alone in SweepCollection, after the
     parallel classes; the other classes mostly wait on engine processes and real-data reads, so many run at once. -->
<RunSettings>
  <xUnit>
    <MaxParallelThreads>12</MaxParallelThreads>
  </xUnit>
</RunSettings>
