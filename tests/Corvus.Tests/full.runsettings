<?xml version="1.0" encoding="utf-8"?>
<!-- CORVUS_ALL_TESTS=1: one class per processor; engines, real programs and reference tools are bounded by machine-wide
     permits (Support/MachinePermits.cs), not by the thread count. Tests that measure the whole process run in a process
     of their own (Support/ChildTest.cs). -->
<RunSettings>
  <!-- Tells the tests they run in the full set, however it was started (fuzz entries then run every iteration). -->
  <RunConfiguration>
    <EnvironmentVariables>
      <CORVUS_ALL_TESTS>1</CORVUS_ALL_TESTS>
    </EnvironmentVariables>
  </RunConfiguration>
  <xUnit>
    <MaxParallelThreads>0</MaxParallelThreads>
  </xUnit>
</RunSettings>
