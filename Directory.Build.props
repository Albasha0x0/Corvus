<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Fixtures are decompiler input: their shape is what the tests read, so analyzers do not reshape them. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('TestFixture'))">
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>
</Project>
