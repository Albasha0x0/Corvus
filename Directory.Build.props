<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Non-Release builds make no git queries, so a new commit alone rebuilds nothing. Configuration is empty here
       unless given. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <!-- GitHub Actions builds map source paths to /_/, so a rebuild elsewhere writes the same PDB paths and image. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Shipped projects and DocsSite restore from committed packages.lock.json files. With CI=true restore is locked:
       a package the lock file does not name fails it. A local restore rewrites the lock file. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Corvus' or '$(MSBuildProjectName)' == 'Corvus.Clr32' or '$(MSBuildProjectName)' == 'DocsSite'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Fixtures are decompiler input, so analyzers do not reshape them. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('TestFixture'))">
    <RunAnalyzers>false</RunAnalyzers>
    <!-- No git queries, so a checkout without .git builds the same image (offsets, MVID). -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
</Project>
