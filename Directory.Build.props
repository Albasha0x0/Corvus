<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Builds other than Release make no git queries (Configuration is still empty here unless given): the commit in
       the informational version and in Source Link's file recompiled every project after each new commit, where now
       a commit alone rebuilds nothing. Release builds keep both. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <!-- The shipped closure restores from committed lock files (packages.lock.json). On CI runners (CI=true, as GitHub
       Actions sets it) every restore is locked: a package version or hash the lock file does not name fails restore,
       so CI and the release build exactly the reviewed packages. A local restore rewrites the lock file. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Corvus' or '$(MSBuildProjectName)' == 'Corvus.Clr32'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Fixtures are decompiler input: their shape is what the tests read, so analyzers do not reshape them. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('TestFixture'))">
    <RunAnalyzers>false</RunAnalyzers>
    <!-- No git queries: the commit in the informational version and Source Link's paths and URL would make a checkout
         without .git (git archive) build another image (offsets, MVID). -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
</Project>
