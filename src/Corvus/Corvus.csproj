<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>corvus</AssemblyName>
    <RootNamespace>Corvus</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>2.7.3</Version>
    <!-- The release targets (release.yml's matrix), so the lock file covers each RID-specific publish; a test keeps
         the lists equal. Left out only of a RID-neutral pack's build, as tools that rewrite the lock file outside
         a restore must see them. Workaround for dotnet/sdk#56774 (tested SDK 10.0.402, no fix yet): with them listed
         the pack leaves out the program even with CreateRidSpecificToolPackages false. _IsPacking is the SDK's
         internal mark of a pack; LockFileTests evaluates both cases. -->
    <RuntimeIdentifiers Condition="'$(_IsPacking)' != 'true' or '$(MSBuildIsRestoring)' == 'true' or '$(RuntimeIdentifier)' != ''">win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- The NuGet .NET tool (dotnet pack): framework-dependent and RID-neutral; the release archives stay self-contained. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <!-- And during restore, where RuntimeIdentifiers is listed, no RID-specific tool packages either. -->
    <CreateRidSpecificToolPackages>false</CreateRidSpecificToolPackages>
    <ToolCommandName>corvus</ToolCommandName>
    <PackageId>CorvusRE</PackageId>
    <PackageType>McpServer</PackageType>
    <Authors>Albasha0x0</Authors>
    <Description>MCP server and command line for reverse engineering and security analysis of .NET assemblies and native PE, ELF and Mach-O binaries: decompile, search, compare builds, patch and save. By default nothing is executed.</Description>
    <PackageTags>mcp;mcp-server;decompiler;reverse-engineering;security;malware-analysis;dotnet;disassembler</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Albasha0x0/Corvus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Albasha0x0/Corvus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <!-- RID-specific publishes (release archives, publish.ps1) are precompiled: about 0.4 s less per cold CLI call. Roslyn
       serves only patch_method_csharp and would add 16 MB. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.dll;Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MCP Registry entry nuget.org reads from the package; a test keeps its versions and id equal to the above. -->
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <!-- the MCP Registry proves ownership of a NuGet package by the mcp-name line in its README -->
    <None Include="PACKAGE.md" Pack="true" PackagePath="/README.md" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <!-- The release's YARA-X libraries, laid out as <rid>/native/<file>, beside the tool's program where the worker probes. -->
  <ItemGroup Condition="'$(YaraXRuntimes)' != ''">
    <None Include="$(YaraXRuntimes)\**\*" Pack="true" PackagePath="tools/$(TargetFramework)/any/runtimes" Visible="false" />
  </ItemGroup>
  <!-- Each library's SHA-256 goes into the assembly; the worker loads a shipped library only when it matches. -->
  <Target Name="YaraXHashes" BeforeTargets="GetAssemblyAttributes" Condition="'$(YaraXRuntimes)' != ''">
    <ItemGroup>
      <YaraXLibrary Include="$(YaraXRuntimes)\*\native\*yara_x_capi*" />
    </ItemGroup>
    <GetFileHash Files="@(YaraXLibrary)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="YaraXHashed" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>YaraX.SHA256:$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(YaraXHashed.FullPath)'))))))</_Parameter1>
        <_Parameter2>%(YaraXHashed.FileHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Corvus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hot methods reach optimized code at once instead of after the startup delay: the first native index build runs about a quarter faster. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Native\Providers\Ida\ida_worker.py" LogicalName="Corvus.Native.Providers.Ida.ida_worker.py" />
    <EmbeddedResource Include="Native\Providers\Ida\corvus_connect.py" LogicalName="Corvus.Native.Providers.Ida.corvus_connect.py" />
    <EmbeddedResource Include="Native\Providers\Live\live_worker.py" LogicalName="Corvus.Native.Providers.Live.live_worker.py" />
    <EmbeddedResource Include="Native\Providers\Live\live_agent.js" LogicalName="Corvus.Native.Providers.Live.live_agent.js" />
    <EmbeddedResource Include="Native\Providers\Ghidra\pyghidra_host.py" LogicalName="Corvus.Native.Providers.Ghidra.pyghidra_host.py" />
    <EmbeddedResource Include="Native\Providers\Ghidra\worker\*.java" LogicalName="Corvus.Native.Providers.Ghidra.worker.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Web\Packages\TrustRoots\*.json" LogicalName="Corvus.Services.Web.Packages.TrustRoots.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsmArm64" Version="2.3.0" />
    <PackageReference Include="dnlib" Version="4.5.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="ICSharpCode.BamlDecompiler" Version="11.1.0.9782" />
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <!-- real-time sessions only: its native helpers (kernel rundown, PDB reading) are left out of the output; aliased, as its
         global PEFile namespace hides the decompiler's PEFile -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" ExcludeAssets="build;buildTransitive" Aliases="TraceEventPackage" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <!-- Pre-release by exception (THIRD-PARTY-NOTICES.md): the 2022.1 line, which reads metadata 24-39, has no stable
         release. -->
    <PackageReference Include="Samboy063.LibCpp2IL" Version="2022.1.0-pre-release.21" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
    <PackageReference Include="Acornima" Version="1.9.1" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="MimeKitLite" Version="4.18.1" />
  </ItemGroup>

  <!-- The 32-bit .NET decoder (a 32-bit DAC cannot load in this process): built and copied to clr32/ beside the server. -->
  <ItemGroup>
    <ProjectReference Include="..\Corvus.Clr32\Corvus.Clr32.csproj" ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;TargetFramework" />
  </ItemGroup>
  <Target Name="IncludeClr32Decoder" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences" Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <_Clr32File Include="$(MSBuildThisFileDirectory)..\Corvus.Clr32\bin\$(Configuration)\net48\*.dll;$(MSBuildThisFileDirectory)..\Corvus.Clr32\bin\$(Configuration)\net48\*.exe;$(MSBuildThisFileDirectory)..\Corvus.Clr32\bin\$(Configuration)\net48\*.exe.config" />
      <None Include="@(_Clr32File)" Link="clr32\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
