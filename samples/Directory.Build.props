<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Samples are decompiler input for the guides: one optimized build in bin/ whatever the configuration, so the
       guides' paths and the IL the tools read are the same for every reader and for the tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <OutputPath>$(MSBuildProjectDirectory)/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RunAnalyzers>false</RunAnalyzers>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- A patched copy saved to bin/patched/ runs with `dotnet bin/patched/Notes.dll`, which needs the runtime config beside it. -->
  <Target Name="StagePatchedFolder" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).runtimeconfig.json" DestinationFolder="$(OutputPath)patched/" SkipUnchangedFiles="true" />
  </Target>
</Project>
