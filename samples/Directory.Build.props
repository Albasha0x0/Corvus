<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- One optimized build in bin/ for every configuration, so guide paths and IL match for readers and tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <!-- The embedded PDB path, and so the image bytes, are the same in every clone. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <OutputPath>$(MSBuildProjectDirectory)/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RunAnalyzers>false</RunAnalyzers>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- `dotnet bin/patched/Notes.dll` needs the runtime config beside the patched copy. -->
  <Target Name="StagePatchedFolder" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).runtimeconfig.json" DestinationFolder="$(OutputPath)patched/" SkipUnchangedFiles="true" />
  </Target>
</Project>
