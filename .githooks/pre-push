#!/bin/sh
# Starts ./test.ps1 -Full -Background -Commit on the commit pushed to main; the push does not wait.
# A clone with a publish/ folder also rebuilds it in the background, so a development relay serves the pushed code.
# Enabled per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)
# The runs started here outlive the push: they must not inherit this repository's GIT_DIR.
unset $(git rev-parse --local-env-vars)
while read -r local_ref local_sha remote_ref remote_sha; do
    # A push of another branch, or one that deletes main (an all-zero sha), starts no run.
    if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        pwsh -NoProfile -File "$root/test.ps1" -Full -Background -Commit "$local_sha" >/dev/null 2>&1 || true
        if [ -d "$root/publish" ]; then
            pwsh -NoProfile -File "$root/publish.ps1" >"${TMPDIR:-${TEMP:-/tmp}}/corvus-publish-after-push.log" 2>&1 &
        fi
    fi
done
exit 0
