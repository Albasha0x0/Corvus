#!/bin/sh
# Starts the full suite in the background on the commit pushed to main (./test.ps1 -Full -Background -Commit); the push
# does not wait for it. Enabled per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_sha remote_ref remote_sha; do
    # A push of another branch, or one that deletes main (an all-zero sha), starts no run.
    if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        pwsh -NoProfile -File "$root/test.ps1" -Full -Background -Commit "$local_sha" >/dev/null 2>&1 || true
    fi
done
exit 0
