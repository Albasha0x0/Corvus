#!/bin/sh
# Rejects a commit message that does not follow the form in CONTRIBUTING.md (commit-msg.ps1 names each problem).
# Enabled per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)
if ! command -v pwsh >/dev/null 2>&1; then
    echo "commit-msg: pwsh not found; message not checked" >&2
    exit 0
fi
exec pwsh -NoProfile -File "$root/.githooks/commit-msg.ps1" "$1"
