{
  "type": "object",
  "properties": {
    "id": {
      "description": "Id for the other dump tools (the path works too).",
      "type": "string"
    },
    "view": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "fileSize": {
      "type": "integer"
    },
    "timeUtc": {
      "type": "string"
    },
    "dumpType": {
      "description": "MINIDUMP_TYPE flags the dump was written with.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system": {
      "type": "object",
      "properties": {
        "architecture": {
          "description": "x64, x86, ARM64...",
          "type": "string"
        },
        "os": {
          "description": "Windows major.minor.build and product type (workstation, server, domain_controller).",
          "type": "string"
        },
        "processors": {
          "type": "integer"
        },
        "buildString": {
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "os",
        "processors"
      ]
    },
    "process": {
      "type": "object",
      "properties": {
        "processId": {
          "type": "integer"
        },
        "mainModule": {
          "type": "string"
        },
        "createTimeUtc": {
          "type": "string"
        },
        "integrity": {
          "description": "Integrity level name (low, medium, high, system...) when recorded.",
          "type": "string"
        },
        "wow64": {
          "description": "A 32-bit process dumped by a 64-bit tool: the 32-bit stacks are not walked.",
          "type": "boolean"
        },
        "runtime": {
          "description": "Managed runtime loaded in the process (CoreCLR, CLR, Mono) or AOT; null for none.",
          "type": "string"
        }
      },
      "required": [
        "wow64"
      ]
    },
    "exception": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "description": "Symbolic name, e.g. EXCEPTION_ACCESS_VIOLATION; null when unknown.",
          "type": "string"
        },
        "description": {
          "description": "What happened, from the parameters: e.g. 'access violation writing 0x0000000000000000 (a null or near-null pointer)'.",
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "threadId": {
          "type": "integer"
        },
        "module": {
          "type": "string"
        },
        "symbol": {
          "description": "module!function+0xoffset of the exception address.",
          "type": "string"
        },
        "symbolSource": {
          "description": "Where the name came from: user, pdb, metadata, discovered, export, nearest_export, none.",
          "type": "string"
        },
        "instruction": {
          "description": "The instruction at the exception address, disassembled, then its bytes in parentheses.",
          "type": "string"
        },
        "instructionSource": {
          "description": "dump_memory, module_image (disk) or module_image (dump_memory); null when the bytes are not available.",
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registers": {
          "description": "Registers of the exception context.",
          "type": "string"
        },
        "thrownTypes": {
          "description": "C++ exceptions: the thrown type and its catchable base types, from the ThrowInfo.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "continuable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "description",
        "address",
        "threadId",
        "parameters",
        "continuable"
      ]
    },
    "managed": {
      "description": ".NET runtime state through its DAC (exception with inner chain, threads, heap); absent without a managed runtime.",
      "type": "object",
      "properties": {
        "runtime": {
          "description": "e.g. .NET 10.0.11 (CoreCLR), .NET Framework 4.8.x (CLR), Mono.",
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "dac": {
          "type": "object",
          "properties": {
            "status": {
              "description": "loaded, not_found, bitness_mismatch, host_unsupported, signature_invalid, download_refused_offline, download_failed, load_failed or unsupported_runtime.",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "detail": {
              "description": "Where the DAC came from, or why none was loaded and what to do.",
              "type": "string"
            }
          },
          "required": [
            "status",
            "detail"
          ]
        },
        "appDomains": {
          "type": "integer"
        },
        "managedThreads": {
          "type": "integer"
        },
        "heap": {
          "type": "object",
          "properties": {
            "walkable": {
              "type": "boolean"
            },
            "segments": {
              "type": "integer"
            },
            "bytes": {
              "type": "integer"
            },
            "reason": {
              "description": "heap_not_captured or heap_not_walkable with the reason; null when the heap can be walked (dump_heap, dump_object).",
              "type": "string"
            }
          },
          "required": [
            "walkable",
            "segments",
            "bytes"
          ]
        },
        "exception": {
          "description": "The managed exception in flight: on the faulting thread for a CLR exception, else on the first thread that has one.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "hResult": {
              "type": "string"
            },
            "address": {
              "description": "Address of the exception object (dump_object).",
              "type": "string"
            },
            "threadId": {
              "type": "integer"
            },
            "stack": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "function": {
                    "description": "Ns.Type.Method(signature), or a runtime frame in brackets.",
                    "type": "string"
                  },
                  "token": {
                    "description": "Method token for decompile_member (with assembly).",
                    "type": "string"
                  },
                  "ilOffset": {
                    "description": "IL offset of the instruction (from the JIT's IL map); null when the dump does not hold it.",
                    "type": "integer"
                  },
                  "module": {
                    "type": "string"
                  },
                  "assembly": {
                    "description": "Id of the loaded assembly that is this build (file name and MVID).",
                    "type": "string"
                  },
                  "buildCheck": {
                    "description": "match (same MVID), mismatch (a loaded assembly of that name is another build), unknown, or null when no such assembly is loaded.",
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "statement": {
                    "description": "The C# statement at the IL offset (decompiled with sequence points), for a frame of a matching build.",
                    "type": "string"
                  }
                },
                "required": [
                  "function"
                ]
              }
            },
            "inner": {
              "description": "Inner exceptions, outermost first (up to 5).",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "hResult": {
                    "type": "string"
                  },
                  "address": {
                    "description": "Address of the exception object (dump_object).",
                    "type": "string"
                  },
                  "threadId": {
                    "type": "integer"
                  },
                  "stack": {
                    "$ref": "#/properties/managed/properties/exception/properties/stack"
                  },
                  "inner": {
                    "description": "Inner exceptions, outermost first (up to 5).",
                    "$ref": "#/properties/managed/properties/exception/properties/inner"
                  }
                },
                "required": [
                  "type",
                  "hResult",
                  "address",
                  "stack",
                  "inner"
                ]
              }
            }
          },
          "required": [
            "type",
            "hResult",
            "address",
            "stack",
            "inner"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "runtime",
        "dac",
        "notes"
      ]
    },
    "counts": {
      "description": "Rows each list view holds.",
      "type": "object",
      "properties": {
        "modules": {
          "type": "integer"
        },
        "threads": {
          "type": "integer"
        },
        "unloadedModules": {
          "type": "integer"
        },
        "memoryRanges": {
          "description": "Captured memory ranges.",
          "type": "integer"
        },
        "memoryRegions": {
          "description": "Regions in the memory info list (VirtualQuery view); 0 when not recorded.",
          "type": "integer"
        },
        "capturedBytes": {
          "type": "integer"
        },
        "fullMemory": {
          "description": "A full-memory dump (Memory64List).",
          "type": "boolean"
        },
        "handles": {
          "type": "integer"
        }
      },
      "required": [
        "modules",
        "threads",
        "unloadedModules",
        "memoryRanges",
        "memoryRegions",
        "capturedBytes",
        "fullMemory",
        "handles"
      ]
    },
    "faultingModule": {
      "description": "The module holding the exception address.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "timeDateStamp": {
          "type": "string"
        },
        "built": {
          "type": "string"
        },
        "fileVersion": {
          "type": "string"
        },
        "pdbName": {
          "type": "string"
        },
        "pdbGuid": {
          "type": "string"
        },
        "pdbAge": {
          "type": "integer"
        },
        "localImage": {
          "description": "matches (a file with this timestamp and size was found), mismatch (a different build) or missing.",
          "type": "string"
        },
        "localPath": {
          "type": "string"
        },
        "localDetail": {
          "type": "string"
        },
        "managed": {
          "description": "A .NET assembly (from the local file's header); null when unknown.",
          "type": "boolean"
        },
        "buildId": {
          "description": "ELF cores: the module's GNU build id, from its header in the core.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "base",
        "size",
        "timeDateStamp",
        "localImage",
        "localDetail"
      ]
    },
    "faultingThread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "faulting": {
          "type": "boolean"
        },
        "suspendCount": {
          "type": "integer"
        },
        "priority": {
          "type": "integer"
        },
        "teb": {
          "type": "string"
        },
        "stackStart": {
          "description": "Lowest captured stack address.",
          "type": "string"
        },
        "stackEnd": {
          "description": "End of the captured stack.",
          "type": "string"
        },
        "instructionPointer": {
          "type": "string"
        },
        "stackPointer": {
          "type": "string"
        },
        "location": {
          "description": "module!function+0xoffset of the instruction pointer.",
          "type": "string"
        },
        "startAddress": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "faulting",
        "suspendCount",
        "priority",
        "teb",
        "stackStart",
        "stackEnd"
      ]
    },
    "handleTypes": {
      "description": "Handles per type, most first (up to 10).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "description": "What the parser could not read (truncation, bad counts, overlapping streams).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "description": "List views: module, thread, memory or unloaded module rows.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "totalExact": {
      "type": "boolean"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "view"
  ]
}
