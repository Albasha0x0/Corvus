      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system": {
      "type": "object",
      "properties": {
        "architecture": {
          "description": "x64, x86, ARM64...",
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "majorVersion": {
          "type": "integer"
        },
        "minorVersion": {
          "type": "integer"
        },
        "buildNumber": {
          "type": "integer"
        },
        "productType": {
          "description": "workstation, domain_controller or server.",
          "type": "string"
        },
        "processors": {
          "type": "integer"
        },
        "processorLevel": {
          "type": "integer"
        },
        "cpuVendor": {
