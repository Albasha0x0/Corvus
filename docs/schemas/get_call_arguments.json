{
  "type": "object",
  "properties": {
    "image": {
      "description": "Image id.",
      "type": "string"
    },
    "scope": {
      "description": "What was searched: a call, the calls in a function, or the calls to a callee.",
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "description": "One call site.",
        "type": "object",
        "properties": {
          "address": {
            "description": "VA of the call instruction.",
            "type": "string"
          },
          "function": {
            "description": "The calling function.",
            "type": "string"
          },
          "callee": {
            "description": "module!name for imports (also late-bound), a function, or the indirect pointer.",
            "type": "string"
          },
          "calleeKind": {
            "description": "import, function, dynamic (GetProcAddress / dlsym), virtual_exact (one RTTI target), virtual_possible (several, listed in Callee), indirect.",
            "type": "string"
          },
          "tailCall": {
            "description": "A jump to the callee (tail call) rather than a call.",
            "type": "boolean"
          },
          "signatureKnown": {
            "description": "Callee signature known (names, count, decoding); else the slots set before the call.",
            "type": "boolean"
          },
          "arguments": {
            "type": "array",
            "items": {
              "description": "One argument of a call.",
              "type": "object",
              "properties": {
                "index": {
                  "description": "0-based position.",
                  "type": "integer"
                },
                "name": {
                  "description": "Parameter name from the API signature; null for callees without one.",
                  "type": "string"
                },
                "type": {
                  "description": "Parameter type (str, int, ptr, enum or flags name...); null without a signature.",
                  "type": "string"
                },
                "location": {
                  "description": "Register or slot: rcx, rdi, xmm0, [rsp+20h], [esp+4h]; ARM64 x0-x7, s0-s7, d0-d7.",
                  "type": "string"
                },
                "kind": {
                  "description": "immediate, string, address, name, result (of a call), global (contents), unknown.",
                  "type": "string"
                },
                "text": {
                  "description": "The value as shown: decoded flags, quoted string, name, or ? when unknown.",
                  "type": "string"
                },
                "value": {
                  "description": "The number for immediates (hex).",
                  "type": "string"
                },
                "address": {
                  "description": "The address (VA) for strings, addresses, names and globals.",
                  "type": "string"
                },
                "derivation": {
                  "description": "The instructions from the call back to the definition, or why it is unknown.",
                  "type": "string"
                }
              },
              "required": [
                "index",
                "location",
                "kind",
                "text",
                "derivation"
              ]
            }
          }
        },
        "required": [
          "address",
          "function",
          "callee",
          "calleeKind",
          "tailCall",
          "signatureKnown",
          "arguments"
        ]
      }
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "notes": {
      "description": "Coverage notes: limits reached, what is not analyzed.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limit": {
      "type": "integer"
    },
    "totalExact": {
      "type": "boolean"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "image",
    "scope",
    "items",
    "offset",
    "total",
    "notes"
  ]
}
