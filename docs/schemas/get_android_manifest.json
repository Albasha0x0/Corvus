{
  "type": "object",
  "properties": {
    "package": {
      "type": "string"
    },
    "versionCode": {
      "type": "string"
    },
    "versionName": {
      "type": "string"
    },
    "minSdk": {
      "type": "integer"
    },
    "targetSdk": {
      "type": "integer"
    },
    "maxSdk": {
      "type": "integer"
    },
    "compileSdk": {
      "type": "integer"
    },
    "split": {
      "description": "Set on a split APK: its split name.",
      "type": "string"
    },
    "application": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "debuggable": {
          "type": "boolean"
        },
        "allowBackup": {
          "type": "boolean"
        },
        "usesCleartextTraffic": {
          "type": "boolean"
        },
        "networkSecurityConfig": {
          "description": "The android:networkSecurityConfig resource and its file.",
          "type": "string"
        },
        "extractNativeLibs": {
          "type": "boolean"
        },
        "testOnly": {
          "type": "boolean"
        },
        "hasCode": {
          "type": "boolean"
        },
        "appComponentFactory": {
          "type": "string"
        },
        "backupAgent": {
          "type": "string"
        },
        "dataExtractionRules": {
          "type": "string"
        },
        "fullBackupContent": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "description": "Used permissions, with maxSdk and sdk-23-only marks.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "declaredPermissions": {
      "description": "Declared permissions with protection level and group.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "componentCounts": {
      "description": "Components per kind, with how many are exported.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "exported": {
      "description": "The first 30 exported components: kind, name, why exported, permission, launcher, deep links.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exportedTotal": {
      "type": "integer"
    },
    "queries": {
      "description": "Packages, intents and providers it queries.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metaData": {
      "description": "Application meta-data, name=value.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlights": {
      "description": "Notable facts: debuggable, cleartext traffic, backups, exported components without permission, deep links.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "description": "view=components: the page of components.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "exported": {
            "description": "android:exported as written.",
            "type": "boolean"
          },
          "effectiveExported": {
            "type": "boolean"
          },
          "exportedReason": {
            "type": "string"
          },
          "permission": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "process": {
            "type": "string"
          },
          "targetActivity": {
            "type": "string"
          },
          "authorities": {
            "type": "string"
          },
          "readPermission": {
            "type": "string"
          },
          "writePermission": {
            "type": "string"
          },
          "grantUriPermissions": {
            "type": "boolean"
          },
          "launcher": {
            "type": "boolean"
          },
          "deepLinks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intentFilters": {
            "description": "Each filter: actions, categories, then data as scheme://host:port/path and MIME type.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metaData": {
            "description": "name=value or resource.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dotNetType": {
            "description": "The .NET type implementing it (Xamarin / MAUI).",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "effectiveExported",
          "exportedReason"
        ]
      }
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "totalExact": {
      "type": "boolean"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "package"
  ]
}
