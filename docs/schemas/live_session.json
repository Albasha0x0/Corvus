{
  "type": "object",
  "properties": {
    "action": {
      "type": "string"
    },
    "session": {
      "description": "Session id; null for action=list and processes.",
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "processId": {
      "type": "integer"
    },
    "state": {
      "description": "suspended, running, stopped, exited, closed or failed.",
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "base"
        ]
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "program": {
            "type": "string"
          },
          "processId": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "session",
          "backend",
          "program",
          "processId",
          "state"
        ]
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "description": "children: held, attached (and its session), running or resumed.",
            "type": "string"
          }
        },
        "required": [
          "processId",
          "name"
        ]
      }
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "dump": {
          "description": "Id for dump_stack, read_dump_memory and the other dump tools.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "dump"
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "modules",
    "sessions"
  ]
}
