{
  "type": "object",
  "properties": {
    "image": {
      "type": "string"
    },
    "view": {
      "description": "similar, duplicates or clusters.",
      "type": "string"
    },
    "function": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "compared": {
      "description": "Functions scanned (similar) or candidate pairs scored (clusters).",
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "kind": {
            "description": "identical (same bytes, addresses masked), same_shape (same graph and instruction shapes; registers, offsets or constants differ), contains (holds most of the query's code) or similar.",
            "type": "string"
          },
          "code": {
            "description": "Jaccard of the instruction-shape 3-grams (registers, addresses and immediates ignored).",
            "type": "number"
          },
          "containment": {
            "description": "Share of the query's 3-grams found in this function.",
            "type": "number"
          },
          "instructions": {
            "type": "integer"
          },
          "blocks": {
            "type": "integer"
          },
          "cfg": {
            "description": "Blocks and edges, query -> this function; same_graph when the CFG shapes match.",
            "type": "string"
          },
          "sharedStrings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharedConstants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharedImports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharedCallees": {
            "description": "Called by both (same image only).",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "image",
          "address",
          "name",
          "score",
          "kind",
          "code",
          "containment",
          "instructions",
          "blocks",
          "cfg",
          "sharedStrings",
          "sharedConstants",
          "sharedImports",
          "sharedCallees"
        ]
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "description": "identical, same_shape or similar (near-duplicates linked by score).",
            "type": "string"
          },
          "members": {
            "type": "integer"
          },
          "redundantBytes": {
            "description": "Bytes of the members after the first.",
            "type": "integer"
          },
          "functions": {
            "description": "The first 50, by address.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "instructions": {
                  "type": "integer"
                },
                "size": {
                  "type": "integer"
                },
                "score": {
                  "description": "Score against the group's first member (clusters: sketch estimate).",
                  "type": "number"
                }
              },
              "required": [
                "address",
                "name",
                "instructions",
                "size",
                "score"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "members",
          "redundantBytes",
          "functions"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limit": {
      "type": "integer"
    },
    "totalExact": {
      "type": "boolean"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "image",
    "view",
    "compared",
    "offset",
    "total",
    "matches",
    "groups",
    "notes"
  ]
}
