{
  "type": "object",
  "properties": {
    "server": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "informationalVersion": {
      "description": "Version, plus +<commit> when known.",
      "type": "string"
    },
    "executable": {
      "description": "The running server program.",
      "type": "string"
    },
    "executableMatches": {
      "description": "Whether Executable is expectedExecutable (also through links); null when none was given.",
      "type": "boolean"
    },
    "installKind": {
      "description": "script, dotnet-tool, dnx, winget, scoop, homebrew or source.",
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "uptimeSeconds": {
      "type": "integer"
    },
    "protocolVersion": {
      "description": "The MCP protocol version negotiated with this client.",
      "type": "string"
    },
    "client": {
      "description": "The client's name and version from its initialize request.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "catalogDigest": {
      "description": "Digest of the tool and prompt catalog (names, schemas, descriptions, annotations; prompt arguments): t<tools>-<hash>.p<prompts>-<hash>.",
      "type": "string"
    },
    "catalogMatches": {
      "description": "Whether CatalogDigest equals expectedCatalogDigest; null when none was given.",
      "type": "boolean"
    },
    "catalogDifference": {
      "description": "On a mismatch, what differs as far as the digests tell (tool or prompt counts, or definitions); else null.",
      "type": "string"
    },
    "tools": {
      "type": "integer"
    },
    "loadedAssemblies": {
      "type": "integer"
    },
    "backgroundIndexing": {
      "type": "string"
    },
    "workingSetMB": {
      "type": "integer"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "available",
          "detail"
        ]
      }
    },
    "longRunningTools": {
      "description": "Tools that can take over 10 s on large inputs.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolsets": {
      "description": "Tool families and whether this server registers them; every family unless the server was started with --toolsets <list> (or CORVUS_TOOLSETS: all, core, or names such as core,dumps).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "inCore": {
            "type": "boolean"
          },
          "tools": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "enabled",
          "inCore",
          "tools",
          "description"
        ]
      }
    },
    "unavailableTools": {
      "description": "Registered tools, or modes of them (e.g. engine=ida), that cannot work here: one row per reason and fix.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        },
        "required": [
          "tools",
          "reason"
        ]
      }
    },
    "notes": {
      "description": "Analyst notes in the per-user store (record_note): open, total and the store directory.",
      "type": "object",
      "properties": {
        "open": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "store": {
          "type": "string"
        }
      },
      "required": [
        "open",
        "total",
        "store"
      ]
    },
    "engineTimeLimits": {
      "description": "Seconds per IDA or Ghidra request (CORVUS_ENGINE_REQUEST_TIMEOUT) and per engine start plus analysis (CORVUS_ENGINE_OPEN_TIMEOUT).",
      "type": "object",
      "properties": {
        "requestSeconds": {
          "type": "integer"
        },
        "openSeconds": {
          "type": "integer"
        }
      },
      "required": [
        "requestSeconds",
        "openSeconds"
      ]
    },
    "engineSessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "workerPid": {
            "type": "integer"
          },
          "state": {
            "description": "opening, idle, busy or closed.",
            "type": "string"
          },
          "busyOp": {
            "description": "The request running (or open/restart), its seconds and the worker's last stage.",
            "type": "string"
          },
          "busySeconds": {
            "type": "number"
          },
          "stage": {
            "type": "string"
          },
          "queued": {
            "description": "Requests waiting for this session.",
            "type": "integer"
          },
          "unsaved": {
            "description": "Unsaved edits a restart would replay.",
            "type": "integer"
          },
          "restarts": {
            "type": "integer"
          },
          "database": {
            "type": "string"
          },
          "reusedDatabase": {
            "type": "boolean"
          },
          "note": {
            "description": "no auto-analysis, or a read-only snapshot of a database another process holds.",
            "type": "string"
          },
          "analysis": {
            "description": "running, complete or partial (the analysis budget ran out).",
            "type": "string"
          }
        },
        "required": [
          "image",
          "engine",
          "state",
          "busySeconds",
          "queued",
          "unsaved",
          "restarts",
          "reusedDatabase"
        ]
      }
    },
    "toolsFileAndTrace": {
      "description": "The --tools-file whitelist in effect (list name or path) and the tools it names; the call trace file (--trace / CORVUS_TRACE).",
      "type": "object",
      "properties": {
        "toolsFile": {
          "type": "string"
        },
        "toolsFileTools": {
          "type": "integer"
        },
        "traceFile": {
          "type": "string"
        }
      }
    },
    "sections": {
      "description": "budget (profile, ceiling, deadline, delivery, with sources), results (kept-result store), caches, calls (leftover calls, lock holders), workers (child PIDs, start times), run.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          }
        },
        "required": [
          "name",
          "fields"
        ]
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "server",
    "version",
    "informationalVersion",
    "executable",
    "installKind",
    "startedAt",
    "uptimeSeconds",
    "catalogDigest",
    "tools",
    "loadedAssemblies",
    "backgroundIndexing",
    "workingSetMB",
    "capabilities",
    "longRunningTools",
    "toolsets",
    "unavailableTools",
    "engineTimeLimits",
    "engineSessions",
    "toolsFileAndTrace",
    "sections"
  ]
}
