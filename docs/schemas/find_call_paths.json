{
  "type": "object",
  "properties": {
    "target": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "Method label or native function.",
                  "type": "string"
                },
                "token": {
                  "description": "Managed: metadata token; native: VA.",
                  "type": "string"
                },
                "assembly": {
                  "description": "Assembly or image id, when it differs from the previous step's.",
                  "type": "string"
                },
                "via": {
                  "description": "Reached by virtual dispatch through this base/interface method.",
                  "type": "string"
                },
                "site": {
                  "description": "Native steps: the call site (VA) in the previous step.",
                  "type": "string"
                },
                "edge": {
                  "description": "Native steps: call, tail, import, virtual_exact, virtual_possible, pointer or pinvoke.",
                  "type": "string"
                },
                "basis": {
                  "description": "observed (the code names it) or derived (through a base or interface declaration, or a delegate field). Native: derived for engine-only, virtual_possible and pointer edges.",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "virtualHops": {
            "type": "integer"
          },
          "nativeHop": {
            "description": "Native targets: the final P/Invoke -> native hop.",
            "type": "string"
          },
          "root": {
            "description": "Native chains: why the first step is a start (entry point, export, TLS callback, address taken, no callers, from).",
            "type": "string"
          }
        },
        "required": [
          "steps",
          "virtualHops"
        ]
      }
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "from": {
      "type": "string"
    },
    "totalExact": {
      "type": "boolean"
    },
    "engine": {
      "description": "Which analysis produced the result: ours (the built-in index), ida (IDA's analysis through idalib) or ghidra (Ghidra's analysis).",
      "type": "string"
    },
    "limit": {
      "type": "integer"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "target",
    "items",
    "offset",
    "total"
  ]
