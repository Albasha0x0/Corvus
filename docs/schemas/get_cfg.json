{
  "type": "object",
  "properties": {
    "image": {
      "type": "string"
    },
    "function": {
      "description": "Function name.",
      "type": "string"
    },
    "address": {
      "description": "Function start (VA).",
      "type": "string"
    },
    "engine": {
      "description": "ours, ida or ghidra.",
      "type": "string"
    },
    "items": {
      "description": "Blocks of this page.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "description": "VA.",
            "type": "string"
          },
          "end": {
            "description": "Exclusive end (VA).",
            "type": "string"
          },
          "instructions": {
            "type": "integer"
          },
          "endKind": {
            "description": "Return, Jump, ConditionalJump, Switch, IndirectJump, TailCall, NoReturnCall, FallThrough...",
            "type": "string"
          },
          "successors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "description": "VA.",
                  "type": "string"
                },
                "kind": {
                  "description": "FallThrough, Jump, ConditionalTaken, ConditionalFallThrough, Switch or TailCall.",
                  "type": "string"
                }
              },
              "required": [
                "to",
                "kind"
              ]
            }
          }
        },
        "required": [
          "start",
          "end",
          "instructions",
          "endKind",
          "successors"
        ]
      }
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "switches": {
      "description": "Switches ending a block of this page.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jump": {
            "description": "The indirect jump (VA).",
            "type": "string"
          },
          "table": {
            "description": "Jump table (VA); null when the engine does not say.",
            "type": "string"
          },
          "tableKind": {
            "description": "absolute, rva, table_relative, base_relative (ARM: base + entry << shift), indexed (ARM32: base + index * 4).",
            "type": "string"
          },
          "entrySize": {
            "type": "integer"
          },
          "entries": {
            "type": "integer"
          },
          "indexTable": {
            "description": "Byte index table in front of the jump table (VA).",
            "type": "string"
          },
          "indexEntries": {
            "type": "integer"
          },
          "bias": {
            "description": "Switched value = table index + bias.",
            "type": "integer"
          },
          "default": {
            "description": "VA for out-of-range values; null when the index is masked, not compared.",
            "type": "string"
          },
          "defaultValues": {
            "description": "Values whose table entry is the default target, as ranges (\"5..9\").",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valuesExact": {
            "description": "False: table indexes not bounded by a compare (masked or assumed base).",
            "type": "boolean"
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "description": "VA.",
                  "type": "string"
                },
                "targetName": {
                  "type": "string"
                },
                "values": {
                  "description": "Switched values as ranges (\"5..9\").",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "target",
                "values"
              ]
            }
          }
        },
        "required": [
          "jump",
          "bias",
          "defaultValues",
          "valuesExact",
          "cases"
        ]
      }
    },
    "unresolvedJumps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "description": "VA.",
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "address",
          "reason"
        ]
      }
    },
    "tailCalls": {
      "description": "Targets of tail calls (VA); first page.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cut": {
      "description": "The function was cut at the instruction limit.",
      "type": "boolean"
    },
    "summary": {
      "description": "Whole function: edges, switches, unresolved jumps, cyclomatic complexity.",
      "type": "object",
      "properties": {
        "blocks": {
          "type": "integer"
        },
        "edges": {
          "type": "integer"
        },
        "switches": {
          "type": "integer"
        },
        "unresolvedJumps": {
          "type": "integer"
        },
        "cyclomatic": {
          "type": "integer"
        }
      },
      "required": [
        "blocks",
        "edges",
        "switches",
        "unresolvedJumps",
        "cyclomatic"
      ]
    },
    "limit": {
      "type": "integer"
    },
    "totalExact": {
      "type": "boolean"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "image",
    "function",
    "address",
    "engine",
    "items",
    "offset",
    "total",
    "switches",
    "unresolvedJumps",
    "tailCalls",
    "cut",
    "summary"
  ]
}
