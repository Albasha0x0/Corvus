{
  "type": "object",
  "properties": {
    "image": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "description": "Another loaded image the reference is in (imports of an export), else null.",
            "type": "string"
          },
          "address": {
            "description": "VA of the referencing instruction or data.",
            "type": "string"
          },
          "kind": {
            "description": "Call, Jump, Read, Write, Address, CallReg, Resolve, DynCall, ...",
            "type": "string"
          },
          "function": {
            "description": "function+offset containing it.",
            "type": "string"
          },
          "detail": {
            "description": "Recovered call arguments, the import it goes through, or the whole row when it has no address.",
            "type": "string"
          },
          "target": {
            "description": "direction=from: VA of the referenced target; null for a reference to the address.",
            "type": "string"
          },
          "of": {
            "description": "With addresses: the target (as given) of this row's section.",
            "type": "string"
          }
        }
      }
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "boundTo": {
      "description": "An import slot: the export it is bound to.",
      "type": "string"
    },
    "engine": {
      "description": "Which analysis produced the result: ours (the built-in index), ida (IDA's analysis through idalib) or ghidra (Ghidra's analysis).",
      "type": "string"
    },
    "engineNote": {
      "description": "Why that engine answered (the engine parameter or server default, and for auto whether an engine's analysis of the image was complete).",
      "type": "string"
    },
    "targets": {
      "description": "With addresses: one item per target, in order, with its reference count or its error.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "properties": {
              "resolved": {
                "type": "string"
              },
              "total": {
                "type": "integer"
              }
            },
            "required": [
              "resolved",
              "total"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "next": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "next"
            ]
          }
        },
        "required": [
          "target"
        ]
      }
    },
    "failed": {
      "description": "With addresses: how many targets failed.",
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "totalExact": {
      "type": "boolean"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "image",
    "target",
    "items",
    "offset",
    "total",
    "engine"
  ]
}
