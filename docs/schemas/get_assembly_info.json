{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "sha256": {
      "description": "SHA-256 of the file as loaded (unsaved edits not included).",
      "type": "string"
    },
    "mvid": {
      "type": "string"
    },
    "runtime": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "targetFramework": {
      "type": "string"
    },
    "entryPoint": {
      "description": "Ns.Type::Method of the entry point.",
      "type": "string"
    },
    "types": {
      "type": "integer"
    },
    "nestedTypes": {
      "type": "integer"
    },
    "namespaces": {
      "type": "integer"
    },
    "methods": {
      "type": "integer"
    },
    "fields": {
      "type": "integer"
    },
    "resources": {
      "type": "integer"
    },
    "referenceAssembly": {
      "type": "boolean"
    },
    "addressedMethods": {
      "description": "Methods with [Address] attributes (dummy assembly).",
      "type": "integer"
    },
    "invalidBodies": {
      "description": "Method bodies that are not valid IL.",
      "type": "integer"
    },
    "invalidExceptionClauses": {
      "description": "Exception clauses of valid bodies with bad flags or ranges, or a misplaced filter.",
      "type": "integer"
    },
    "unsavedEdits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referenceCount": {
      "description": "Assembly references.",
      "type": "integer"
    },
    "unresolvedReferences": {
      "description": "References that resolve to nothing.",
      "type": "integer"
    },
    "metadataIssueCount": {
      "description": "Structural metadata problems in streams, tables, indexes and P/Invoke rows.",
      "type": "integer"
    },
    "transformers": {
      "description": "The transformation tool, with evidence; view=transforms adds 'layer: ' rows.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "confidence": {
            "description": "marker (its type or attribute), strong or likely (the shape of its runtime code).",
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "confidence",
          "evidence"
        ]
      }
    },
    "references": {
      "description": "view=references or all.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "description": "Where it resolves, or not found.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ]
      }
    },
    "attributes": {
      "description": "view=metadata or all: assembly attributes (first 40).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tables": {
      "description": "view=metadata or all: row counts of the non-empty metadata tables, in table order.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string"
          },
          "rows": {
            "type": "integer"
          }
        },
        "required": [
          "table",
          "rows"
        ]
      }
    },
    "heaps": {
      "description": "view=metadata or all.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heap": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "indexBytes": {
            "type": "integer"
          }
        },
        "required": [
          "heap",
          "bytes"
        ]
      }
    },
    "metadataIssues": {
      "description": "view=metadata or all: the first 50 metadata problems.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "description": "Short code: duplicate_stream, unknown_stream, stream_out_of_range, unknown_tables, extra_data_flag, bad_metadata_root, implmap_scope_out_of_range, implmap_name_out_of_range, implmap_member_out_of_range, moduleref_name_out_of_range, bad_table_index, bad_list_index, bad_coded_index, bad_heap_index, decompiler_reader.",
            "type": "string"
          },
          "location": {
            "description": "Stream, table and row (token) concerned.",
            "type": "string"
          },
          "fileOffset": {
            "description": "File offset of the structure, when known (hex).",
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "location",
          "detail"
        ]
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "fullName",
    "file",
    "sha256",
    "mvid",
    "runtime",
    "kind",
    "machine",
    "types",
    "nestedTypes",
    "namespaces",
    "methods",
    "fields",
    "resources",
    "referenceAssembly",
    "addressedMethods",
    "invalidBodies",
    "invalidExceptionClauses",
    "unsavedEdits",
    "referenceCount",
    "unresolvedReferences",
    "metadataIssueCount"
  ]
}
