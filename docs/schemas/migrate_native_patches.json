{
  "type": "object",
  "properties": {
    "oldImage": {
      "type": "string"
    },
    "newImage": {
      "type": "string"
    },
    "source": {
      "description": "in_memory, json or the patch set's path.",
      "type": "string"
    },
    "dryRun": {
      "type": "boolean"
    },
    "applied": {
      "type": "boolean"
    },
    "editIds": {
      "description": "The applied patches' edits (undo_native_edit).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patches": {
      "type": "integer"
    },
    "carried": {
      "description": "Patches that apply (or would, in a dry run).",
      "type": "integer"
    },
    "refused": {
      "type": "integer"
    },
    "refusedBy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "reason",
          "count"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer"
          },
          "oldAddress": {
            "type": "string"
          },
          "newAddress": {
            "type": "string"
          },
          "origin": {
            "description": "asm (re-assembled at the new address) or bytes (applied verbatim).",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "description": "applied, would_apply (dry run) or refused.",
            "type": "string"
          },
          "reason": {
            "description": "How it was carried or why not (docs/migration-reasons.md).",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "tier": {
            "type": "integer"
          },
          "replacementBytes": {
            "description": "The replacement bytes at the new address, hex (re-assembled for patch_asm).",
            "type": "string"
          }
        },
        "required": [
          "number",
          "oldAddress",
          "origin",
          "description",
          "status",
          "reason",
          "detail",
          "confidence"
        ]
      }
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limit": {
      "type": "integer"
    },
    "totalExact": {
      "type": "boolean"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "oldImage",
    "newImage",
    "source",
    "dryRun",
    "applied",
    "editIds",
    "patches",
    "carried",
    "refused",
    "refusedBy",
    "items",
    "offset",
    "total",
    "notes"
  ]
}
