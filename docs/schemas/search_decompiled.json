{
  "type": "object",
  "properties": {
    "image": {
      "type": "string"
    },
    "engine": {
      "description": "ida or ghidra.",
      "type": "string"
    },
    "pattern": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "function": {
            "description": "Start VA of the function.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "line": {
            "description": "1-based line of the pseudocode.",
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "function",
          "name",
          "line",
          "text"
        ]
      }
    },
    "functionsTotal": {
      "description": "Functions in scope (after filter; thunks left out).",
      "type": "integer"
    },
    "offset": {
      "description": "Index of the first function searched (offset counts functions, not hits).",
      "type": "integer"
    },
    "functionsSearched": {
      "description": "Functions searched by this call.",
      "type": "integer"
    },
    "failed": {
      "description": "Functions that did not decompile (their error and the rest in the text).",
      "type": "integer"
    },
    "nextOffset": {
      "description": "offset= for the next call; absent when every function in scope was searched.",
      "type": "integer"
    },
    "hasMore": {
      "type": "boolean"
    },
    "totalExact": {
      "description": "False when functions were left: the hits are those of the functions searched.",
      "type": "boolean"
    },
    "stoppedBy": {
      "description": "Why the call stopped before the end: hits (limit), functions (maxFunctions) or time (timeoutSeconds).",
      "type": "string"
    },
    "engineNote": {
      "description": "Why this engine answered.",
      "type": "string"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "image",
    "engine",
    "pattern",
    "items",
    "functionsTotal",
    "offset",
    "functionsSearched",
    "failed",
    "hasMore",
    "totalExact"
  ]
}
