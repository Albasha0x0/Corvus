{
  "type": "object",
  "properties": {
    "processId": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "architecture": {
      "description": "x64, x86, ARM64: the process's own instruction set (x86 for a WoW64 process).",
      "type": "string"
    },
    "wow64": {
      "type": "boolean"
    },
    "startTimeUtc": {
      "type": "string"
    },
    "runtime": {
      "description": "Managed runtime loaded in the process (CoreCLR, CLR, Mono) or Il2Cpp; null for none.",
      "type": "string"
    },
    "access": {
      "description": "The handles this call opened, with their access rights: the read-only guarantee.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moduleCount": {
      "type": "integer"
    },
    "modulesOffset": {
      "type": "integer"
    },
    "modulesTruncated": {
      "type": "boolean"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "timeDateStamp": {
            "type": "string"
          },
          "built": {
            "type": "string"
          },
          "checkSum": {
            "type": "string"
          },
          "fileVersion": {
            "type": "string"
          },
          "pdbName": {
            "type": "string"
          },
          "pdbGuid": {
            "type": "string"
          },
          "pdbAge": {
            "type": "integer"
          },
          "localImage": {
            "description": "matches (a file with this timestamp and size was found), mismatch (a different build) or missing.",
            "type": "string"
          },
          "localPath": {
            "type": "string"
          },
          "localDetail": {
            "type": "string"
          },
          "managed": {
            "description": "A .NET assembly (from the local file's header); null when unknown.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "path",
          "base",
          "end",
          "size",
          "timeDateStamp",
          "checkSum",
          "localImage",
          "localDetail"
        ]
      }
    },
    "regionCount": {
      "description": "Regions matching regionFilter (all regions: regionsTotal).",
      "type": "integer"
    },
    "regionsTotal": {
      "type": "integer"
    },
    "regionFilter": {
      "type": "string"
    },
    "regionsOffset": {
      "type": "integer"
    },
    "regionsTruncated": {
      "type": "boolean"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "base": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "state": {
            "description": "commit, reserve or free.",
            "type": "string"
          },
          "protection": {
            "description": "Page protection, e.g. PAGE_EXECUTE_READ; null for reserved and free memory.",
            "type": "string"
          },
          "type": {
            "description": "image, mapped or private; null for free memory.",
            "type": "string"
          },
          "allocationBase": {
            "type": "string"
          },
          "module": {
            "description": "The module whose image holds the region, or null.",
            "type": "string"
          }
        },
        "required": [
          "base",
          "end",
          "size",
          "state"
        ]
      }
    },
    "threadCount": {
      "type": "integer"
    },
    "threadsOffset": {
      "type": "integer"
    },
    "threadsTruncated": {
      "type": "boolean"
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "suspendCount": {
            "description": "Read from the kernel (NtQueryInformationThread ThreadSuspendCount); inspection never changes it.",
            "type": "integer"
          },
          "priority": {
            "type": "integer"
          },
          "basePriority": {
            "type": "integer"
          },
          "teb": {
            "type": "string"
          },
          "stackLow": {
            "type": "string"
          },
          "stackHigh": {
            "type": "string"
          },
          "startAddress": {
            "type": "string"
          },
          "startSymbol": {
            "description": "module!function of the thread's start address.",
            "type": "string"
          },
          "instructionPointer": {
            "type": "string"
          },
          "stackPointer": {
            "type": "string"
          },
          "location": {
            "description": "module!function+0xoffset of the instruction pointer.",
            "type": "string"
          },
          "registers": {
            "type": "string"
          },
          "frameCount": {
            "description": "Frames walked (the walk is bounded by maxFrames); 0 when stacks are not requested.",
            "type": "integer"
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "address": {
                  "type": "string"
                },
                "stackPointer": {
                  "type": "string"
                },
                "module": {
                  "type": "string"
                },
                "moduleOffset": {
                  "type": "string"
                },
                "symbol": {
                  "description": "module!function+0xoffset, or module+0xoffset when the function has no name.",
                  "type": "string"
                },
                "function": {
                  "type": "string"
                },
                "symbolSource": {
                  "description": "user, pdb, il2cpp, discovered, export, nearest_export (a guess) or none.",
                  "type": "string"
                },
                "functionAddress": {
                  "type": "string"
                },
                "kind": {
                  "description": "native, managed (JIT or ReadyToRun code), unloaded_module or unknown.",
                  "type": "string"
                },
                "method": {
                  "description": "How the frame was found: context, unwind_info, epilog, leaf, machine_frame, frame_pointer, call_target (x86: the return address whose call targets this function), scan (heuristic), or clr (the runtime's own stack walk).",
                  "type": "string"
                },
                "heuristic": {
                  "description": "Found by scanning the stack for a return address: may be a stale value.",
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                },
                "token": {
                  "description": "Managed frames: the method token, for decompile_member with assembly.",
                  "type": "string"
                },
                "ilOffset": {
                  "description": "Managed frames: IL offset of the instruction, when the dump holds the JIT's IL map.",
                  "type": "integer"
                },
                "assembly": {
                  "description": "Managed frames: id of the loaded assembly that is this build (file name and MVID).",
                  "type": "string"
                },
                "buildCheck": {
                  "description": "Managed frames: match, mismatch (the loaded assembly of that name is another build), or unknown.",
                  "type": "string"
                },
                "statement": {
                  "description": "Managed frames: the C# statement at the IL offset (decompiled with sequence points), for a matching build.",
                  "type": "string"
                }
              },
              "required": [
                "index",
                "address",
                "stackPointer",
                "kind",
                "method",
                "heuristic"
              ]
            }
          },
          "stackStop": {
            "description": "Why the walk ended: end_of_stack, max_frames, left_the_stack, no_unwind_data, ...; null when not walked.",
            "type": "string"
          },
          "heuristicFrames": {
            "type": "integer"
          },
          "error": {
            "description": "What could not be read for this thread (exited, registers not read), or null.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "frameCount",
          "frames",
          "heuristicFrames"
        ]
      }
    },
    "detached": {
      "description": "Every handle to the process and its threads was closed before returning.",
      "type": "boolean"
    },
    "handlesOpened": {
      "type": "integer"
    },
    "handlesClosed": {
      "type": "integer"
    },
    "stillRunning": {
      "description": "The process was still running when inspection ended.",
      "type": "boolean"
    },
    "notes": {
      "description": "Where names and unwind data came from, and what was not covered.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "processId",
    "name",
    "architecture",
    "wow64",
    "access",
    "moduleCount",
    "modulesOffset",
    "modulesTruncated",
    "modules",
    "regionCount",
    "regionsTotal",
    "regionFilter",
    "regionsOffset",
    "regionsTruncated",
    "regions",
    "threadCount",
    "threadsOffset",
    "threadsTruncated",
    "threads",
    "detached",
    "handlesOpened",
    "handlesClosed",
    "stillRunning",
    "notes"
  ]
}
