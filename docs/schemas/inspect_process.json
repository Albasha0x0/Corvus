{
  "type": "object",
  "properties": {
    "processId": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "view": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "architecture": {
      "description": "x64, x86, ARM64: the process's own instruction set (x86 for a WoW64 process).",
      "type": "string"
    },
    "wow64": {
      "type": "boolean"
    },
    "runtime": {
      "description": "Managed runtime loaded in the process (CoreCLR, CLR, Mono) or Il2Cpp; null for none.",
      "type": "string"
    },
    "access": {
      "description": "The handles this call opened, with their access rights: the read-only guarantee.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detached": {
      "description": "Every handle to the process and its threads was closed before returning.",
      "type": "boolean"
    },
    "handlesOpened": {
      "type": "integer"
    },
    "handlesClosed": {
      "type": "integer"
    },
    "stillRunning": {
      "description": "The process was still running when inspection ended.",
      "type": "boolean"
    },
    "notes": {
      "description": "Where names and unwind data came from, and what was not covered.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "startTimeUtc": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "integer"
        },
        "threads": {
          "type": "integer"
        },
        "regions": {
          "description": "Committed regions.",
          "type": "integer"
        },
        "regionsTotal": {
          "description": "All regions, reserved and free included.",
          "type": "integer"
        }
      },
      "required": [
        "modules",
        "threads",
        "regions",
        "regionsTotal"
      ]
    },
    "mainModule": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "timeDateStamp": {
          "type": "string"
        },
        "built": {
          "type": "string"
        },
        "fileVersion": {
          "type": "string"
        },
        "pdbName": {
          "type": "string"
        },
        "pdbGuid": {
          "type": "string"
        },
        "pdbAge": {
          "type": "integer"
        },
        "localImage": {
          "description": "matches (a file with this timestamp and size was found), mismatch (a different build) or missing.",
          "type": "string"
        },
        "localPath": {
          "type": "string"
        },
        "localDetail": {
          "type": "string"
        },
        "managed": {
          "description": "A .NET assembly (from the local file's header); null when unknown.",
          "type": "boolean"
        },
        "buildId": {
          "description": "ELF cores: the module's GNU build id, from its header in the core.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "base",
        "size",
        "timeDateStamp",
        "localImage",
        "localDetail"
      ]
    },
    "largestRegions": {
      "description": "The largest committed regions.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "base": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "state": {
            "description": "commit, reserve or free; null for a captured range without region information.",
            "type": "string"
          },
          "protection": {
            "type": "string"
          },
          "type": {
            "description": "image, mapped or private.",
            "type": "string"
          },
          "module": {
            "description": "The module whose image holds it.",
            "type": "string"
          },
          "captured": {
            "description": "Bytes of it the dump holds; null for a live process or a missing region file.",
            "type": "integer"
          }
        },
        "required": [
          "base",
          "end",
          "size"
        ]
      }
    },
    "thread": {
      "description": "view=stacks: the thread walked.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "suspendCount": {
          "description": "Read from the kernel (NtQueryInformationThread ThreadSuspendCount); inspection never changes it.",
          "type": "integer"
        },
        "priority": {
          "type": "integer"
        },
        "teb": {
          "type": "string"
        },
        "stackLow": {
          "type": "string"
        },
        "stackHigh": {
          "type": "string"
        },
        "startAddress": {
          "type": "string"
        },
        "startSymbol": {
          "description": "module!function of the thread's start address.",
          "type": "string"
        },
        "instructionPointer": {
          "type": "string"
        },
        "stackPointer": {
          "type": "string"
        },
        "location": {
          "description": "module!function+0xoffset of the instruction pointer.",
          "type": "string"
        },
        "registers": {
          "type": "string"
        },
        "error": {
          "description": "What could not be read for this thread (exited, registers not read), or null.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "stackStop": {
      "description": "view=stacks: why the walk ended (end_of_stack, max_frames, left_the_stack, ...).",
      "type": "string"
    },
    "items": {
      "description": "List views: module, region, thread or frame rows.",
      "type": "array"
    },
    "offset": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "totalExact": {
      "type": "boolean"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextOffset": {
      "type": "integer"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "processId",
    "name",
    "view",
    "architecture",
    "wow64",
    "access",
    "detached",
    "handlesOpened",
    "handlesClosed",
    "stillRunning",
    "notes"
  ]
}
