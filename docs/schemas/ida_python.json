{
  "description": "A script's outcome; past the page the whole text is kept under resultId.",
  "type": "object",
  "properties": {
    "image": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "result": {
      "description": "The final expression's value (ida_python).",
      "type": "string"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "error": {
      "description": "The exception and traceback, with allowError=true (else the call is an error).",
      "type": "string"
    },
    "saved": {
      "description": "Whether the database was saved after the script.",
      "type": "boolean"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object"
    },
    "resultId": {
      "type": "string"
    }
  },
  "required": [
    "image",
    "engine",
    "saved"
  ]
}
